
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Flashcard LCT Matematika</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f1f5ff;color:#172554}
header{text-align:center;padding:25px 15px 12px}
header h1{margin:8px 0;font-size:clamp(24px,5vw,36px)}
header p{color:#64748b;line-height:1.5}
main{max-width:760px;margin:auto;padding:12px 16px 35px}
select,input{width:100%;padding:13px;margin:5px 0 12px;border:1px solid #cbd5e1;border-radius:12px;font-size:16px;background:white}
.info{display:flex;justify-content:space-between;gap:10px;color:#64748b;font-size:14px;margin:8px 0}
.progress{height:7px;background:#dbeafe;border-radius:10px;margin-bottom:20px;overflow:hidden}
#bar{height:100%;width:0;background:#6366f1;transition:width .2s}
.card{height:300px;perspective:1000px;cursor:pointer}
.inner{height:100%;position:relative;transition:transform .45s;transform-style:preserve-3d}
.card.flipped .inner{transform:rotateY(180deg)}
.face{position:absolute;inset:0;border-radius:24px;backface-visibility:hidden;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:25px;box-shadow:0 10px 28px #33415520}
.front{background:linear-gradient(135deg,#fff,#dbeafe)}
.back{background:linear-gradient(135deg,#dcfce7,#d1fae5);transform:rotateY(180deg)}
.label{font-size:12px;letter-spacing:2px;font-weight:bold;color:#64748b;margin-bottom:20px}
.face h2{font-size:clamp(20px,4vw,28px);line-height:1.45;margin:0}
.hint{position:absolute;bottom:15px;color:#64748b;font-size:12px}
.buttons{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:17px 0}
button{padding:12px 15px;border:0;border-radius:11px;font-size:14px;font-weight:bold;cursor:pointer}
.blue{background:#4f46e5;color:white}
.white{background:white;color:#172554;border:1px solid #cbd5e1}
.green{background:#dcfce7;color:#166534}
.orange{background:#ffedd5;color:#9a3412}
.scores{display:flex;gap:10px;margin:15px 0}
.score{flex:1;text-align:center;background:white;border-radius:14px;padding:12px}
.score strong{display:block;font-size:24px}
small{color:#64748b}
details{background:white;border-radius:14px;padding:15px;margin-top:22px}
summary{font-weight:bold;cursor:pointer}
.item{padding:12px 0;border-bottom:1px solid #e2e8f0;line-height:1.5}
.item b{display:block;margin-bottom:5px}
.item span{color:#166534}
footer{text-align:center;color:#64748b;font-size:12px;padding:20px}
@media(max-width:450px){.card{height:280px}.buttons button{flex:1}}
</style>
</head>
<body>
<header>
<div>📚 MEDIA BELAJAR INTERAKTIF</div>
<h1>Flashcard LCT Matematika</h1>
<p>Kelas 4–6 SD • Pelajari konsep, balik kartu, dan uji ingatanmu!</p>
</header>
<main>
<select id="kategori" aria-label="Pilih materi">
<option value="Semua">📚 Semua Materi</option>
<option>Bilangan & Operasi Hitung</option>
<option>Pecahan & Perbandingan</option>
<option>Pengukuran</option>
<option>Geometri</option>
<option>Pola & Aljabar</option>
<option>Data & Peluang</option>
</select>
<input id="cari" placeholder="🔎 Cari pertanyaan..." aria-label="Cari pertanyaan">
<div class="info"><span id="jumlah">64 kartu</span><span id="posisi">Kartu 1</span></div>
<div class="progress"><div id="bar"></div></div>

<div class="card" id="kartu" onclick="balik()">
<div class="inner">
<div class="face front">
<div class="label" id="labelDepan">PERTANYAAN</div>
<h2 id="depan">Memuat kartu...</h2>
<div class="hint">👆 Tekan kartu untuk melihat jawaban</div>
</div>
<div class="face back">
<div class="label">JAWABAN & PENJELASAN</div>
<h2 id="belakang"></h2>
<div class="hint">👆 Tekan kartu untuk kembali</div>
</div>
</div>
</div>

<div class="buttons">
<button class="white" onclick="pindah(-1)">← Sebelumnya</button>
<button class="blue" onclick="balik()">Balik Kartu ↻</button>
<button class="white" onclick="pindah(1)">Berikutnya →</button>
</div>
<div class="buttons">
<button class="orange" onclick="tandai('ulang')">× Perlu Latihan</button>
<button class="green" onclick="tandai('paham')">✓ Sudah Paham</button>
<button class="white" onclick="acak()">🔀 Acak</button>
</div>
<div class="scores">
<div class="score"><strong id="paham">0</strong><small>✓ Sudah paham</small></div>
<div class="score"><strong id="ulang">0</strong><small>× Perlu latihan</small></div>
</div>
<details>
<summary>Lihat semua pertanyaan dan jawaban</summary>
<div id="daftar"></div>
</details>
<footer>Flashcard LCT Matematika • Bisa digunakan di HP dan laptop</footer>
</main>

<script>
const data = [
["Bilangan & Operasi Hitung","Apa arti 6 × 7?","6 kelompok berisi 7 benda. Hasilnya 42."],
["Bilangan & Operasi Hitung","Berapa hasil 8 × 9?","72. Cara cepat: 8 × 10 − 8 = 72."],
["Bilangan & Operasi Hitung","Berapa hasil 144 ÷ 12?","12, karena 12 × 12 = 144."],
["Bilangan & Operasi Hitung","Berapa hasil 25 × 16?","400. Hitung 25 × 4 × 4 = 100 × 4."],
["Bilangan & Operasi Hitung","Berapa hasil 120 − 4 × 15?","60. Perkalian dikerjakan dahulu: 120 − 60."],
["Pecahan & Perbandingan","Apa itu pecahan senilai?","Pecahan yang nilainya sama, misalnya 1/2 = 2/4."],
["Pecahan & Perbandingan","Berapa hasil 1/2 + 1/4?","3/4. Samakan penyebut: 2/4 + 1/4 = 3/4."],
["Pecahan & Perbandingan","Ubah 0,75 menjadi pecahan!","0,75 = 75/100 = 3/4."],
["Pecahan & Perbandingan","Apa arti perbandingan 2 : 3?","Setiap 2 bagian pertama dibandingkan dengan 3 bagian kedua."],
["Pengukuran","Berapa 2 meter dalam sentimeter?","200 cm, karena 1 meter = 100 cm."],
["Pengukuran","Berapa 3 kg dalam gram?","3.000 gram, karena 1 kg = 1.000 gram."],
["Pengukuran","Berapa menit dalam 2 jam 30 menit?","150 menit: 2 × 60 + 30 = 150."],
["Geometri","Bagaimana menghitung keliling persegi?","Keliling = 4 × sisi. Jika sisi 5 cm, keliling 20 cm."],
["Geometri","Bagaimana menghitung luas persegi panjang?","Luas = panjang × lebar."],
["Geometri","Bagaimana menghitung volume kubus?","Volume = sisi × sisi × sisi. Sisi 3 cm menghasilkan 27 cm³."],
["Geometri","Apa itu simetri lipat?","Garis yang membagi bangun menjadi dua bagian yang saling menutupi tepat."],
["Pola & Aljabar","Apa aturan pola 3, 6, 9, 12, ...?","Bertambah 3. Bilangan berikutnya adalah 15."],
["Pola & Aljabar","Apa bilangan berikutnya: 2, 4, 8, 16, ...?","32. Setiap bilangan dikalikan 2."],
["Pola & Aljabar","Jika x + 8 = 20, berapa x?","x = 12, karena 20 − 8 = 12."],
["Pola & Aljabar","Apa itu variabel?","Simbol seperti x atau n yang mewakili suatu nilai."],
["Data & Peluang","Apa arti batang lebih tinggi pada diagram batang?","Nilai atau frekuensi kategori tersebut lebih besar."],
["Data & Peluang","Apa fungsi tabel data?","Menyusun informasi agar mudah dibaca dan dibandingkan."],
["Data & Peluang","Apa itu peluang?","Ukuran kemungkinan kejadian terjadi, dari 0 sampai 1."],
["Data & Peluang","Apa peluang muncul gambar saat melempar koin seimbang?","1/2 atau 50%."],
["Pola & Aljabar","Apa perbedaan variabel dan konstanta?","Variabel dapat mewakili nilai berbeda; konstanta adalah nilai tetap."],
["Pola & Aljabar","Apa arti 3x?","3 dikalikan x, bukan 3 ditambah x."],
["Pola & Aljabar","Jika x = 5, berapa 2x + 3?","2(5) + 3 = 13."],
["Pola & Aljabar","Sederhanakan 4x + 2x!","6x. Gabungkan suku sejenis."],
["Pola & Aljabar","Sederhanakan 7a − 3a + 2!","4a + 2."],
["Pola & Aljabar","Sederhanakan 3x + 4 + 2x + 1!","5x + 5."],
["Pola & Aljabar","Jika x − 7 = 15, berapa x?","x = 22. Tambahkan 7 pada kedua ruas."],
["Pola & Aljabar","Jika 4x = 28, berapa x?","x = 7. Bagi kedua ruas dengan 4."],
["Pola & Aljabar","Jika x ÷ 5 = 6, berapa x?","x = 30. Kalikan kedua ruas dengan 5."],
["Pola & Aljabar","Jika 2x + 3 = 13, berapa x?","x = 5. Kurangi 3, lalu bagi 2."],
["Pola & Aljabar","Jika 3x − 4 = 17, berapa x?","x = 7. Tambahkan 4, lalu bagi 3."],
["Pola & Aljabar","Tuliskan: suatu bilangan ditambah 8 sama dengan 20!","x + 8 = 20."],
["Pola & Aljabar","Tuliskan: lima kali suatu bilangan adalah 35!","5x = 35. Bilangannya 7."],
["Pola & Aljabar","Umur Ani x tahun. Berapa umurnya 4 tahun lagi?","x + 4 tahun."],
["Pola & Aljabar","Panjang persegi panjang x cm, lebar 3 cm. Berapa kelilingnya?","K = 2(x + 3) = 2x + 6 cm."],
["Pola & Aljabar","Apa aturan pola 5, 8, 11, 14, ...?","Bertambah 3. Berikutnya 17."],
["Pola & Aljabar","Apa aturan pola 30, 25, 20, 15, ...?","Berkurang 5. Berikutnya 10."],
["Pola & Aljabar","Apa bilangan berikutnya: 1, 4, 9, 16, ...?","25. Polanya bilangan kuadrat: 1², 2², 3², 4², 5²."],
["Pola & Aljabar","Apa bilangan berikutnya: 2, 5, 10, 17, ...?","26. Selisihnya 3, 5, 7, lalu 9."],
["Pola & Aljabar","Bagaimana menentukan aturan pola bilangan?","Bandingkan suku berurutan, cari selisih atau rasio, lalu uji aturan."],
["Pola & Aljabar","Pola 4, 7, 10, 13, ... Berapa suku ke-6?","19. Polanya bertambah 3: 4, 7, 10, 13, 16, 19."],
["Pola & Aljabar","Jika 1 buku Rp4.000, berapa harga n buku?","4.000n rupiah."],
["Pola & Aljabar","Jika x = 4 dan y = 3, berapa x + 2y?","4 + 2(3) = 10."],
["Pola & Aljabar","Apakah 3x + 2x = 5x?","Ya. Suku sejenis dapat dijumlahkan."],
["Pola & Aljabar","Apakah 3x + 2 = 5x?","Tidak. 3x dan 2 bukan suku sejenis."],
["Pola & Aljabar","Apa sifat distributif?","a(b + c) = ab + ac. Contoh: 3(4 + 2) = 18."],
["Pola & Aljabar","Sederhanakan 2(x + 5)!","2x + 10. Kalikan 2 ke setiap suku."],
["Bilangan & Operasi Hitung","Berapa 48 ÷ 6 × 2?","16. Perkalian dan pembagian dikerjakan dari kiri ke kanan."],
["Bilangan & Operasi Hitung","Berapa 5 + 3 × 4?","17. Perkalian dahulu: 5 + 12 = 17."],
["Pecahan & Perbandingan","Berapa 2/3 + 1/6?","5/6. Ubah 2/3 menjadi 4/6, lalu jumlahkan."],
["Pecahan & Perbandingan","Berapa 3/4 × 8?","6. Hitung 8 ÷ 4 × 3."],
["Pecahan & Perbandingan","Berapa 2,5 + 1,75?","4,25. Sejajarkan tanda koma."],
["Pecahan & Perbandingan","3 pensil berharga Rp6.000. Berapa harga 5 pensil?","Rp10.000. Satu pensil Rp2.000, dikalikan 5."],
["Geometri","Luas segitiga dengan alas 10 cm dan tinggi 6 cm?","1/2 × 10 × 6 = 30 cm²."],
["Geometri","Keliling persegi dengan sisi 12 cm?","4 × 12 = 48 cm."],
["Geometri","Volume balok berukuran 4 × 3 × 5 cm?","4 × 3 × 5 = 60 cm³."],
["Pengukuran","Berapa lama dari pukul 08.35 sampai 10.10?","1 jam 35 menit."],
["Data & Peluang","Data 4, 6, 6, 8. Berapa mediannya?","6. Dua nilai tengahnya adalah 6 dan 6."],
["Data & Peluang","Ada 3 bola merah dan 2 biru. Peluang mengambil merah?","3/5, jika semua bola memiliki peluang terambil yang sama."]
];

let deck=[...data], index=0, flipped=false;
const known=new Set(), review=new Set();
const $=id=>document.getElementById(id);

function cocok(){
 const k=$("kategori").value, s=$("cari").value.toLowerCase().trim();
 return deck.filter(x=>(k==="Semua"||x[0]===k)&&(!s||x.join(" ").toLowerCase().includes(s)));
}
function aman(s){
 return s.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function render(){
 const arr=cocok();
 if(index>=arr.length)index=0;
 $("jumlah").textContent=arr.length+" kartu";
 $("posisi").textContent=arr.length?`Kartu ${index+1} dari ${arr.length}`:"Tidak ada kartu";
 $("bar").style.width=arr.length?((index+1)/arr.length*100)+"%":"0%";
 $("paham").textContent=known.size;
 $("ulang").textContent=review.size;
 if(!arr.length){
  $("depan").textContent="Kartu tidak ditemukan";
  $("belakang").textContent="Coba kata kunci lain.";
  $("labelDepan").textContent="PENCARIAN";
  $("kartu").classList.remove("flipped");
  $("daftar").innerHTML="";
  return;
 }
 const x=arr[index];
 $("depan").textContent=x[1];
 $("belakang").textContent=x[2];
 $("labelDepan").textContent=x[0].toUpperCase();
 $("kartu").classList.toggle("flipped",flipped);
 $("daftar").innerHTML=arr.map((a,i)=>
  `<div class="item"><b>${i+1}. ${aman(a[1])}</b><span>${aman(a[2])}</span><br><small>${aman(a[0])}</small></div>`
 ).join("");
}
function balik(){
 if(!cocok().length)return;
 flipped=!flipped;
 $("kartu").classList.toggle("flipped",flipped);
}
function pindah(n){
 const arr=cocok();if(!arr.length)return;
 index=(index+n+arr.length)%arr.length;
 flipped=false;render();
}
function tandai(t){
 const arr=cocok();if(!arr.length)return;
 const q=arr[index][1];
 known.delete(q);review.delete(q);
 if(t==="paham")known.add(q);else review.add(q);
 pindah(1);
}
function acak(){
 for(let i=deck.length-1;i>0;i--){
  const j=Math.floor(Math.random()*(i+1));
  [deck[i],deck[j]]=[deck[j],deck[i]];
 }
 index=0;flipped=false;render();
}
$("kategori").addEventListener("change",()=>{index=0;flipped=false;render()});
$("cari").addEventListener("input",()=>{index=0;flipped=false;render()});
document.addEventListener("keydown",e=>{
 if(e.key==="ArrowRight")pindah(1);
 if(e.key==="ArrowLeft")pindah(-1);
});
render();
</script>
</body>
</html>
